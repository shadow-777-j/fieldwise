# FIELDWISE AI Backend Configuration
# Leave DATABASE_URL blank or use sqlite:///./fieldwise.db for zero-config local persistence.
# For PostgreSQL + PostGIS production deployment:
# DATABASE_URL=postgresql+psycopg://fieldwise:password@localhost:5432/fieldwise
DATABASE_URL=sqlite:///./fieldwise.db

# Google Earth Engine (optional for Phase 1; required for 30m Landsat C2 L2 pixel extraction via GEE)
# Run `earthengine authenticate` OR supply a service account JSON path (NEVER place in frontend env!)
EARTH_ENGINE_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# NASA POWER Daily Point API
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point

# Cache TTL in hours for retrieved satellite/climate time-series
OBSERVATION_CACHE_TTL_HOURS=24
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

